# Environment
DEBUG=true
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/orbit
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT (CHANGE IN PRODUCTION - run: python scripts/generate_secrets.py)
JWT_SECRET_KEY=CHANGE_ME_RUN_scripts_generate_secrets_py
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption (CHANGE IN PRODUCTION - run: python scripts/generate_secrets.py)
ENCRYPTION_KEY=CHANGE_ME_RUN_scripts_generate_secrets_py

# Demo account (local dev only — set both to enable /auth/dev-login)
# DEMO_EMAIL=test@orbit.com
# DEMO_PASSWORD=your-demo-password
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# AI Services
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_FAST_FALLBACKS=openai/gpt-oss-120b,groq/compound-mini
GROQ_MODEL_REASONING=qwen/qwen3.8-27b
GROQ_MODEL_REASONING_FALLBACKS=qwen/qwen3.6-27b,openai/gpt-oss-120b
LLM_STRICT_STARTUP=true
LLM_TOOL_CALLING_MODE=auto
LLM_AUDIT_ENABLED=true
LLM_MAX_RETRIES=6

# Agent outreach (Phase 3) — AGENT_SEND_TEST_INBOX is REQUIRED when enabling sends
AGENT_SEND_ENABLED=false
AGENT_SEND_TEST_INBOX=
AGENT_UNDO_WINDOW_SECONDS=60
AGENT_KILL_SWITCH_GLOBAL=false

# CORS (comma-separated for multiple origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://yourdomain.com

# Monitoring (optional)
SENTRY_DSN=

# Server
HOST=0.0.0.0
PORT=8000
